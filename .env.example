# ─────────────────────────────────────────────────────────────────────
# Volia — variables d'environnement (régénéré depuis grep process.env, WS15)
# ─────────────────────────────────────────────────────────────────────
# Renseigner sur Vercel (Production + Preview). Aucune valeur secrète ici.
# « requis » = l'app plante ou une fonction clé casse sans ; « optionnel » = no-op
# gracieux si absent. Sur les webhooks, un secret absent EN PROD est fail-closed
# (WS6) → renseigner tous les *_SECRET / *_WEBHOOK_SECRET pour la prod.

# ─── Supabase (requis) ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://kqrarrrojdtxijkhejhg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Prospection / enrichissement (requis pour le produit héros) ────────
GOOGLE_PLACES_API_KEY=
SERPER_API_KEY=
ANTHROPIC_API_KEY=
MILLIONVERIFIER_API_KEY=       # vérification email waterfall
APOLLO_API_KEY=                # optionnel (source enrichissement d'appoint)

# ─── Stripe (requis : billing) ──────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Prices actifs (freemium) : Solo/Pro/Business, mensuel + annuel
STRIPE_SOLO_PRICE_ID=
STRIPE_SOLO_YEARLY_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_BUSINESS_YEARLY_PRICE_ID=
# Packs de crédits Prospection (one-time)
STRIPE_CREDITS_S_PRICE_ID=
STRIPE_CREDITS_M_PRICE_ID=
STRIPE_CREDITS_L_PRICE_ID=
# Sièges équipe (Business multi-user)
STRIPE_SEAT_PRICE_ID=
# Coupons promo (optionnels — défauts codés) : MAX99, Business legacy
STRIPE_MAX_PROMO_COUPON_ID=
STRIPE_BUSINESS_PROMO_COUPON_ID=
# Plans legacy grandfathered (optionnels)
STRIPE_ENTERPRISE_PRICE_ID=
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=

# ─── Resend — emails transactionnels + inbound (requis) ─────────────────
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
# Webhooks Resend — fail-closed en prod (WS6). Renseigner en prod.
RESEND_WEBHOOK_SECRET=            # events (delivered/opened/bounced…) svix
RESEND_INBOUND_WEBHOOK_SECRET=    # replies → auto-create CRM
RESEND_INBOUND_CONTACT_SECRET=    # contact@ (feedback mining)
RESEND_INBOUND_STOP_SECRET=       # stop@ (kill-switch autopilot)
INBOUND_REPLY_DOMAIN=             # ex. reply.volia.fr

# ─── Rate-limit distribué (requis en prod : WS7-A) ──────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Crons + admin (requis en prod : WS7-C fail-closed) ─────────────────
CRON_SECRET=                     # sans lui, 39 crons refusent de s'exécuter
LIFECYCLE_BC_LIVE=               # '1' = arme les séquences B2/B3 + C1-C3 (sinon dry-run : le cron liste sans envoyer)
VOLIA_ADMIN_USER_ID=             # user id admin (bypass gating admin)

# ─── Chiffrement secrets tenant + captcha ───────────────────────────────
SENDER_SECRETS_ENCRYPTION_KEY=   # chiffre les auth_token Twilio BYO en base
RECAPTCHA_SECRET_KEY=            # captcha forms (fail-closed en prod si activé)

# ─── Autonomy / Autopilot ───────────────────────────────────────────────
AUTONOMOUS_MODE_ENABLED=         # 'true' active les actions autonomes
AUTONOMY_FOUNDER_EMAIL=          # destinataire des digests/approbations
REPLY_AI_DISABLED=               # 'true' coupe la rédaction IA des replies
GLOBAL_POOL_WRITE=               # 'true' autorise l'écriture du pool global
GITHUB_REPO=                     # owner/repo pour auto-fix-bugs / changelog
GITHUB_TOKEN=                    # PAT (auto-fix-bugs, publish changelog)

# ─── Monitoring (Sentry) — optionnel ────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_API_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── Alertes ops — optionnel ────────────────────────────────────────────
ALERT_EMAIL=
OPS_ALERT_EMAIL=

# ─── NPS / lifecycle — optionnel ────────────────────────────────────────
NPS_TOKEN_SECRET=                # signe les liens NPS

# ─── Twilio (SMS — feature désactivée par flag, optionnel) ──────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_STATUS_CALLBACK_URL=

# ─── URLs publiques ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://volia.fr
NEXT_PUBLIC_SITE_URL=https://volia.fr
NEXT_PUBLIC_BOOKING_URL=         # Cal.com démo (fallback codé)
NEXT_PUBLIC_TRUSTPILOT_BUSINESS_UNIT_ID=

# ─── Cal.com — CTA "Réserver une démo" (BookDemoButton) ─────────────────
# Fallbacks codés : anthony-malartre / 15min
NEXT_PUBLIC_CAL_USERNAME=anthony-malartre
NEXT_PUBLIC_CAL_EVENT_TYPE=15min

# ─── Tracking publicitaire (gated consentement, tous optionnels/no-op) ──
NEXT_PUBLIC_GA_ID=                          # GA4, ex. G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=                  # Meta Pixel ID
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_LINKEDIN_CONVERSION_SIGNUP=
NEXT_PUBLIC_LINKEDIN_CONVERSION_PURCHASE=
